# ------------------------------------------------------------
# Aqilbek.uz — environment variables
# Copy to .env.local and fill in. NEVER commit real keys.
# ------------------------------------------------------------

# Supabase (Project Settings → API). Only the public anon key goes to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site URL (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mistral AI (server-only) — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
# Optional: separate model for quiz / practice generation (defaults to MISTRAL_MODEL)
# MISTRAL_QUIZ_MODEL=mistral-large-latest
# MISTRAL_MODERATION_MODEL=mistral-moderation-latest
# Optional: route chat through a Mistral Agent (falls back to MISTRAL_MODEL on error)
# MISTRAL_AGENT_ID=

# Optional fallback provider (server-only), used when Mistral fails or is not configured
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_GUARD_MODEL=meta-llama/llama-guard-4-12b

# AI tuning (optional)
# AI_TEMPERATURE=0.4
# AI_MAX_TOKENS=2048
# AI_QUIZ_MAX_TOKENS=6000
# AI_TIMEOUT_MS=60000
# AI_MAX_RETRIES=2
# AI_SAFE_PROMPT=true

# Safety / moderation (optional)
# AI_MODERATION_ENABLED=true
# AI_MODERATION_THRESHOLD=0.7

# Per-student usage limits (admins can override the daily ones in /admin/settings)
LIMIT_CHAT_PER_DAY=60
LIMIT_GENERATIONS_PER_DAY=15
LIMIT_REQUESTS_PER_MINUTE=8
# APP_TIMEZONE=Asia/Tashkent
